# ookla speedtest (1.2.0)
powershell -Command "Invoke-WebRequest -Uri 'https://install.speedtest.net/app/cli/ookla-speedtest-1.2.0-win64.zip' -OutFile 'C:\Windows\Temp\speedtest.zip'; Expand-Archive -Path 'C:\Windows\Temp\speedtest.zip' -DestinationPath 'C:\Windows\Temp\Speedtest' -Force; Copy-Item 'C:\Windows\Temp\Speedtest\speedtest.exe' -Destination 'C:\Windows\speedtest.exe' -Force; Remove-Item 'C:\Windows\Temp\speedtest.zip'; Remove-Item 'C:\Windows\Temp\Speedtest' -Recurse -Force; Write-Host 'Done. You can now type speedtest.'"

# ookla speedtest (latest)
powershell -Command "$req = Invoke-WebRequest -Uri 'https://www.speedtest.net/apps/cli' -UseBasicParsing; $url = [regex]::Match($req.Content, 'https://install\.speedtest\.net/app/cli/ookla-speedtest-[0-9\.]+-win64\.zip').Value; if ($url) { Write-Host 'Downloading latest from:' $url; Invoke-WebRequest -Uri $url -OutFile 'C:\Windows\Temp\speedtest.zip'; Expand-Archive -Path 'C:\Windows\Temp\speedtest.zip' -DestinationPath 'C:\Windows\Temp\Speedtest' -Force; Copy-Item 'C:\Windows\Temp\Speedtest\speedtest.exe' -Destination 'C:\Windows\speedtest.exe' -Force; Remove-Item 'C:\Windows\Temp\speedtest.zip', 'C:\Windows\Temp\Speedtest' -Recurse -Force; Write-Host 'Done. You can now type speedtest.' } else { Write-Host 'Failed to detect latest URL.' }"

