# samsung drives NCQ depth of 1...
for d in /sys/block/sd*; do grep -qE "SSD 8[567]" $d/device/model 2>/dev/null && echo 1 > $d/device/queue_depth && echo "$(basename $d) $(cat $d/device/model): $(cat $d/device/queue_depth)"; done

# samsung drives current NCQ depth...
for d in /sys/block/sd*; do grep -qE "SSD 8[567]" $d/device/model 2>/dev/null && echo "$(basename $d) $(cat $d/device/model): $(cat $d/device/queue_depth)"; done

# non-rotational current NCQ depth...
for d in /sys/block/sd*; do [ "$(cat $d/queue/rotational 2>/dev/null)" = "0" ] && echo "$(basename $d) $(cat $d/device/model): $(cat $d/device/queue_depth)"; done
