# script execution commands...
Set-ExecutionPolicy RemoteSigned
# Temporary (Current Session Only):
Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass
# For Only Your User Account:
Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy RemoteSigned
# Running a Single Script via CMD:
powershell -ExecutionPolicy Bypass -File "C:\Path\To\YourScript.ps1"
# if script was downloaded... might need unblock...
Unblock-File -Path C:\Users\Admin\script.ps1

# rename pc and reboot...
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command Rename-Computer -NewName "NewPCName" -Restart

# renew domain trust relationship
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$secpw = ConvertTo-SecureString 'YourDomainAdminPassword' -AsPlainText -Force; $cred = New-Object System.Management.Automation.PSCredential ('DOMAIN\AdminUser', $secpw); Test-ComputerSecureChannel -Repair -Credential $cred"

# install smartmontools...
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$w=(Get-ChildItem 'C:\Program Files\WindowsApps' -Filter 'winget.exe' -Recurse -EA SilentlyContinue | Select-Object -First 1).FullName; if($w){ & $w install smartmontools.smartmontools --accept-package-agreements --accept-source-agreements --silent } else { Write-Error 'winget.exe not found in WindowsApps' }"
# determine drive number...
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "Get-Partition -DriveLetter C | Get-Disk | Select-Object Number, FriendlyName, BusType | Format-Table -AutoSize"
# full report...
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$d=(Get-Partition -DriveLetter C | Get-Disk).Number; $bin='C:\Program Files\smartmontools\bin\smartctl.exe'; & $bin -a \"/dev/pd$d\""
# quick report...
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$d=(Get-Partition -DriveLetter C | Get-Disk).Number; $bin='C:\Program Files\smartmontools\bin\smartctl.exe'; & $bin -H \"/dev/pd$d\""
# hybrid summary...
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$d=(Get-Partition -DriveLetter C | Get-Disk).Number; & 'C:\Program Files\smartmontools\bin\smartctl.exe' -i -H \"/dev/pd$d\""
