*** create script ***

#!/bin/sh
# /config/scripts/kuma-push.sh
start=$(date +%s%3N)
curl -fsS --max-time 10 -o /dev/null https://1.1.1.1
ms=$(( $(date +%s%3N) - start ))
curl -fsS --max-time 15 -G \
  "https://uptimekuma.push.url/api/push/YOURTOKEN" \
  --data-urlencode "status=up" \
  --data-urlencode "msg=ok" \
  --data-urlencode "ping=${ms}" \
  >/dev/null 2>&1

*** set executable ***

chmod +x /config/scripts/kuma-push.sh

*** configure task ***

configure
set system task-scheduler task kuma-push interval 1m
set system task-scheduler task kuma-push executable path /config/scripts/kuma-push.sh
commit
save
exit
